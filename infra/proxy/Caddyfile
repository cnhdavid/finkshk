{
	email {$ACME_EMAIL}
}

www.finkshk.de {
	redir https://finkshk.de{uri} permanent
}

finkshk.de {
	encode zstd gzip

	handle /api/* {
		reverse_proxy fink-prod-api:8080
	}

	handle {
		reverse_proxy fink-prod-web:3000
	}
}

test.finkshk.de {
	encode zstd gzip

	header X-Robots-Tag "noindex, nofollow"

	basic_auth {
		{$TEST_BASIC_AUTH_USER} {$TEST_BASIC_AUTH_HASH}
	}

	handle /api/* {
		reverse_proxy fink-test-api:8080
	}

	handle {
		reverse_proxy fink-test-web:3000
	}
}
